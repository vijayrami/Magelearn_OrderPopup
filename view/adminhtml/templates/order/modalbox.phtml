<?php
/**
 * @var \Magelearn\OrderPopup\Block\Adminhtml\Order\ModalBox $block
 */
?>

<div id="popup-modal" style="display: none;">

    <div class="admin__fieldset">

        <div class="admin__field field">
            <label class="admin__field-label" for="whatsapp-phone">
                <span><?= $block->escapeHtml(__('Phone Number')) ?></span>
            </label>

            <div class="admin__field-control">
                <input
                    type="text"
                    id="whatsapp-phone"
                    name="phone"
                    class="admin__control-text"
                    value="<?= $block->escapeHtmlAttr($block->getOrderPhone()) ?>"
                />
            </div>
        </div>

        <div class="admin__field field">
            <label class="admin__field-label" for="whatsapp-message">
                <span><?= $block->escapeHtml(__('Message')) ?></span>
            </label>

            <div class="admin__field-control">
                <textarea
                    id="whatsapp-message"
                    name="message"
                    rows="8"
                    class="admin__control-textarea"
                ><?= $block->escapeHtml($block->getMessage()) ?></textarea>
            </div>
        </div>

    </div>

</div>

<script>
require([
    'jquery',
    'Magento_Ui/js/modal/modal',
    'mage/translate'
], function ($, modal) {
    'use strict';

    var options = {
        type: 'popup',
        responsive: true,
        innerScroll: true,
        title: $.mage.__('Send WhatsApp Message'),
        modalClass: 'magelearn-whatsapp-modal',
        buttons: [
            {
                text: $.mage.__('Send WhatsApp'),
                class: 'action-primary',
                click: function () {
                    var popup = this;

                    $.ajax({
                        url: '<?= $block->escapeUrl($block->getFormUrl()) ?>',
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            form_key: window.FORM_KEY,
                            phone: $('#whatsapp-phone').val(),
                            message: $('#whatsapp-message').val()
                        },
                        showLoader: true
                    }).done(function (response) {
                        if (response.success) {
                            alert(response.message);
                            popup.closeModal();
                            return;
                        }

                        alert(response.message);
                    }).fail(function () {
                        alert(
                            $.mage.__(
                                'Unable to send the WhatsApp message.'
                            )
                        );
                    });
                }
            },
            {
                text: $.mage.__('Close'),
                class: '',
                click: function () {
                    this.closeModal();
                }
            }
        ]
    };

    modal(
        options,
        $('#popup-modal')
    );
});
</script>